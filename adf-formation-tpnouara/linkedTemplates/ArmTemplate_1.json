		{
			"name": "[concat(parameters('factoryName'), '/DF_Clean_Ecogaz')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_ADLS_Source_CopyDataTP",
								"type": "DatasetReference"
							},
							"name": "Ecogaz"
						}
					],
					"sinks": [
						{
							"linkedService": {
								"referenceName": "LS_SQL_CopyDataTP",
								"type": "LinkedServiceReference"
							},
							"name": "sink"
						}
					],
					"transformations": [
						{
							"name": "select1"
						},
						{
							"name": "derivedColumn1"
						},
						{
							"name": "weekend"
						},
						{
							"name": "FilterCouleur"
						},
						{
							"name": "aggregate1"
						}
					],
					"scriptLines": [
						"source(output(",
						"          {Journée gazière} as date,",
						"          {Couleur du signal (ENG)} as string,",
						"          {Couleur du signal (FR)} as string,",
						"          {Indice de couleur} as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> Ecogaz",
						"Ecogaz select(mapColumn(",
						"          Date_Signal = {Journée gazière},",
						"          {Couleur du signal (ENG)},",
						"          {Couleur du signal (FR)},",
						"          Niveau = {Indice de couleur}",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> select1",
						"select1 derive({Libelle_Couleur } = iif(Niveau==1, 'Vert', iif(Niveau==2, 'Orange', 'Rouge')),",
						"          Day = dayOfWeek(Date_Signal)) ~> derivedColumn1",
						"derivedColumn1 derive({ Est_WeekEnd} = dayOfWeek(toDate(Day)) == 1 || dayOfWeek(toDate(Day)) == 7) ~> weekend",
						"weekend filter(equals({Libelle_Couleur },\"Vert\")) ~> FilterCouleur",
						"FilterCouleur aggregate(groupBy({Libelle_Couleur }),",
						"     Nombre_Alertes = count()) ~> aggregate1",
						"aggregate1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'table',",
						"     store: 'sqlserver',",
						"     schemaName: 'dbo',",
						"     tableName: 'Stats_Ecogaz_Alertes',",
						"     insertable: true,",
						"     updateable: false,",
						"     deletable: false,",
						"     upsertable: false,",
						"     recreate: true,",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DT_Data_SQL')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_SQL_DATA_ECOGAZ",
								"type": "DatasetReference"
							},
							"name": "Conso"
						}
					],
					"sinks": [
						{
							"linkedService": {
								"referenceName": "LS_SQL_CopyDataTP",
								"type": "LinkedServiceReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "CastColumn"
						},
						{
							"name": "TransformColumn"
						},
						{
							"name": "Aggregate"
						},
						{
							"name": "Modification"
						}
					],
					"scriptLines": [
						"source(output(",
						"          Date as date,",
						"          Heure as string,",
						"          {Date heure} as string,",
						"          {Intensité GES de la consommation (gCO₂eq/kWh)} as integer,",
						"          {Part des EnR dans la consommation (%)} as integer,",
						"          Source as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     inferDriftedColumnTypes: true,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table',",
						"     partitionBy('key',",
						"          0,",
						"          Date",
						"     )) ~> Conso",
						"Conso cast(output(",
						"          {Date heure} as timestamp 'yyyy-MM-dd\\'T\\'HH:mm:ss'",
						"     ),",
						"     errors: true) ~> CastColumn",
						"CastColumn derive(Source = initCap(Source)) ~> TransformColumn",
						"TransformColumn aggregate(groupBy(Source),",
						"     CountLignes = count(Source)) ~> Aggregate",
						"Aggregate alterRow(upsertIf(true())) ~> Modification",
						"Modification sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'table',",
						"     store: 'sqlserver',",
						"     schemaName: 'dbo',",
						"     tableName: 'Agg_source',",
						"     insertable: true,",
						"     updateable: false,",
						"     deletable: false,",
						"     upsertable: true,",
						"     keys:['Source'],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
