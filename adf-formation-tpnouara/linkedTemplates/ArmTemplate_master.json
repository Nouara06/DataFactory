{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nom de fabrique de données",
			"defaultValue": "adf-formation-tpnouara"
		},
		"LS_ADLS_CopyDataTP_accountKey": {
			"type": "secureString",
			"metadata": "Chaîne sécurisée pour « accountKey » de « LS_ADLS_CopyDataTP »"
		},
		"LS_ADLS_Storage_accountKey": {
			"type": "secureString",
			"metadata": "Chaîne sécurisée pour « accountKey » de « LS_ADLS_Storage »"
		},
		"LS_SQL_CopyDataTP_password": {
			"type": "secureString",
			"metadata": "Chaîne sécurisée pour « password » de « LS_SQL_CopyDataTP »"
		},
		"LS_ADLS_CopyDataTP_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saformationtpnouara.dfs.core.windows.net/"
		},
		"LS_ADLS_Storage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saformationtpnouara.dfs.core.windows.net/"
		},
		"LS_REST_ODRE_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().LS_base_URL}"
		},
		"LS_SQL_CopyDataTP_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-formation-server.database.windows.net"
		},
		"LS_SQL_CopyDataTP_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db-formation-tp-nouara"
		},
		"LS_SQL_CopyDataTP_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "db-nouara"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI pour le compte de stockage contenant des modèles ARM liés"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Jeton SAS pour le compte de stockage contenant des modèles ARM liés"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-formation-tpnouara_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_CopyDataTP_accountKey": {
						"value": "[parameters('LS_ADLS_CopyDataTP_accountKey')]"
					},
					"LS_ADLS_Storage_accountKey": {
						"value": "[parameters('LS_ADLS_Storage_accountKey')]"
					},
					"LS_SQL_CopyDataTP_password": {
						"value": "[parameters('LS_SQL_CopyDataTP_password')]"
					},
					"LS_ADLS_CopyDataTP_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_CopyDataTP_properties_typeProperties_url')]"
					},
					"LS_ADLS_Storage_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_Storage_properties_typeProperties_url')]"
					},
					"LS_REST_ODRE_properties_typeProperties_url": {
						"value": "[parameters('LS_REST_ODRE_properties_typeProperties_url')]"
					},
					"LS_SQL_CopyDataTP_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_CopyDataTP_properties_typeProperties_server')]"
					},
					"LS_SQL_CopyDataTP_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_CopyDataTP_properties_typeProperties_database')]"
					},
					"LS_SQL_CopyDataTP_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_CopyDataTP_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-formation-tpnouara_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-formation-tpnouara_ArmTemplate_0')]"
			]
		}
	]
}