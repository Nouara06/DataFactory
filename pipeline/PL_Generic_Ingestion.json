{
	"name": "PL_Generic_Ingestion",
	"properties": {
		"activities": [
			{
				"name": "Copy data1",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_ADLS_TP",
						"type": "DatasetReference",
						"parameters": {
							"DS_Folder": "TP1",
							"DS_Filename": {
								"value": "@pipeline().parameters.Pl_target_file",
								"type": "Expression"
							},
							"DS_StorageContainer": "input"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_TP",
						"type": "DatasetReference",
						"parameters": {
							"DS_Folder": "TP2",
							"DS_Filename": {
								"value": "@concat(formatDateTime(utcNow(), 'yyyy-MM-dd'), '_', pipeline().parameters.Pl_target_file)",
								"type": "Expression"
							},
							"DS_StorageContainer": "output"
						}
					}
				]
			}
		],
		"parameters": {
			"Pl_target_file": {
				"type": "string"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-08T14:03:09Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}